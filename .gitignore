htmlcov/

# --- IDE/OS ---
.vscode/
.idea/
.DS_Store

# Script de experimento do usuário (não faz parte do atado)
im_angry.py

# Projeto baseline (conteúdo do encontro, PII)
baseline/

# Scripts scratch do usuário (experimentos, fora do atado)
scratch_*.py

