# --- Dados do usuário e intermediários do atado ---
# work/ contém WAVs normalizados, manifest, e o redaction_map.json (PII) — nunca versionar
work/
**/work/
# saídas de projetos de exemplo (grandes, específicas do usuário)
out/
**/out/

# --- Amostras/áudio + conteúdo do encontro (institucional, PII/LGPD — não versionar) ---
# Ignora a árvore samples/ inteira: áudios, imagem de contexto e a transcrição de
# referência contêm nomes reais de participantes e conteúdo institucional.
samples/

# --- Modelos / caches de ML ---
*.pt
*.pth
*.ckpt
.cache/
models/

