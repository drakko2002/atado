#!/usr/bin/env bash
# Guardrails de commit:
#  1) bloqueia segredos (tokens HF/provider/GitHub) nos arquivos staged;
#  2) bloqueia MÍDIA (áudio/vídeo — neste projeto é sempre conteúdo de reunião/PII);
#  3) bloqueia arquivos > 10 MB (provável mídia/modelo, nunca código).
# Ative uma vez: git config core.hooksPath .githooks
set -uo pipefail
staged=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$staged" ] && exit 0

fail=0

# 2) mídia nunca entra no repo (conteúdo de reunião é dado pessoal/LGPD)
media=$(echo "$staged" | grep -iE '\.(mp3|mp4|wav|m4a|ogg|opus|flac|mkv|mov|webm|avi|aac|wma)$' || true)
if [ -n "$media" ]; then
  echo "❌ BLOQUEADO: arquivos de mídia staged (conteúdo de reunião = PII/LGPD):"
  echo "$media" | sed 's/^/   /'
  fail=1
fi

# 3) arquivos grandes (>10MB)
while IFS= read -r f; do
  [ -f "$f" ] || continue
  size=$(stat -c%s "$f" 2>/dev/null || echo 0)
  if [ "$size" -gt 10485760 ]; then
    echo "❌ BLOQUEADO: $f tem $((size / 1048576)) MB (>10 MB — mídia/modelo não entra no repo)"
    fail=1
  fi
done <<< "$staged"

# 1) segredos
# shellcheck disable=SC2086
if ! bash scripts/scan_secrets.sh $staged; then
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "Commit abortado pelos guardrails (.githooks/pre-commit)."
  exit 1
fi
exit 0
